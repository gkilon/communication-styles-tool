rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow read: if isAdmin();

      // A user can create/update their own profile, but can never set or change
      // their own role — it must stay 'user' on create, and stay unchanged on update.
      // Only an existing admin can grant/change roles.
      allow create: if isAuth() && request.auth.uid == userId
                     && request.resource.data.role == 'user';
      allow update: if isAuth() && request.auth.uid == userId
                     && request.resource.data.role == resource.data.role;
      allow write: if isAdmin();
    }

    // ORGANIZATIONS
    match /organizations/{orgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TEAMS
    match /teams/{teamId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ACCESS CODES
    match /access_codes/{codeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // SETTINGS
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // QUOTA (backend only)
    match /quota/{docId} {
      allow read, write: if false;
    }
  }
}
