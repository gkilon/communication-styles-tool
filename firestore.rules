rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuth() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // USERS
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow read: if isAdmin();

      // A user can create/update their own profile, but can never set or change
      // their own role — it must stay 'user' on create, and stay unchanged on update.
      // Only an existing admin can grant/change roles.
      allow create: if isAuth() && request.auth.uid == userId
                     && request.resource.data.role == 'user';
      allow update: if isAuth() && request.auth.uid == userId
                     && request.resource.data.role == resource.data.role;
      allow write: if isAdmin();
    }

    // ADVISOR CONVERSATIONS — private to their owner. Rules do not cascade from the
    // user document above, so admins can NOT read these from the dashboard.
    match /users/{userId}/coach_chats/{chatId} {
      allow read, delete: if isAuth() && request.auth.uid == userId;
      allow create, update: if isAuth() && request.auth.uid == userId
                             && request.resource.data.messages.size() <= 200
                             && request.resource.data.title is string
                             && request.resource.data.title.size() <= 120;
    }

    // "WHAT I KNOW ABOUT YOU" — the advisor's picture of the user. Private to its owner
    // (not even admins can read it); the user edits and deletes it from the advisor page.
    match /users/{userId}/coach_profile/{docId} {
      allow read, delete: if isAuth() && request.auth.uid == userId;
      allow create, update: if isAuth() && request.auth.uid == userId
                             && request.resource.data.items is list
                             && request.resource.data.items.size() <= 40;
    }

    // ORGANIZATIONS — only the admin dashboard reads these directly now;
    // the participant flow goes through /api/validate-code (Admin SDK, server-side).
    match /organizations/{orgId} {
      allow read, write: if isAdmin();
    }

    // TEAMS — same reasoning as ORGANIZATIONS above.
    match /teams/{teamId} {
      allow read, write: if isAdmin();
    }

    // ACCESS CODES — same reasoning; codes are no longer publicly listable.
    match /access_codes/{codeId} {
      allow read, write: if isAdmin();
    }

    // SETTINGS — same reasoning; the legacy global password is no longer public.
    match /settings/{docId} {
      allow read, write: if isAdmin();
    }

    // QUOTA (backend only)
    match /quota/{docId} {
      allow read, write: if false;
    }
  }
}